---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Confirmar exclusão · RapTrak" description="Confirme a exclusão dos seus dados no RapTrak.">
  <Header />

  <main id="conteudo" class="wrap pt-14 pb-24 lg:pt-20">
    <div class="mx-auto max-w-xl">
      <h1 class="display-lg">Exclusão de dados</h1>

      <div id="verify-loading" class="mt-10" role="status">
        <div class="mb-4 size-8 animate-spin rounded-full border-2 border-accent border-t-transparent motion-reduce:animate-none"></div>
        <p class="text-text-2">Processando sua confirmação…</p>
      </div>

      <div id="verify-success" class="mt-10 hidden">
        <h2 class="text-3xl">Exclusão confirmada</h2>
        <dl class="mt-6 divide-y divide-hairline border-y border-hairline">
          <div class="py-4"><dt class="font-semibold">Prazo pra desistir</dt><dd class="mt-1 text-text-2">Você tem até <span id="grace-date" class="font-semibold text-text"></span> pra cancelar.</dd></div>
          <div class="py-4"><dt class="font-semibold">Exclusão permanente</dt><dd class="mt-1 text-text-2">Sua conta já está desativada. Depois de 30 dias, seus dados pessoais são apagados.</dd></div>
          <div class="py-4"><dt class="font-semibold">O que fica</dt><dd class="mt-1 text-text-2">Resultados, troféus e comentários em batalhas continuam, como “Usuário deletado”.</dd></div>
        </dl>
        <div class="mt-6 rounded-[var(--radius-md)] border border-warning/40 bg-warning/10 p-4 text-text">
          <strong class="font-semibold">Mudou de ideia?</strong> Escreva pra <a href="mailto:lgpd@raptrak.me" class="underline underline-offset-4">lgpd@raptrak.me</a> antes dessa data pra cancelar.
        </div>
        <a href="/" class="btn btn-primary mt-8">Voltar ao site</a>
      </div>

      <div id="verify-error" class="mt-10 hidden">
        <h2 class="text-3xl">Não deu pra confirmar</h2>
        <p id="verify-error-msg" class="mt-3 text-text-2" role="alert"></p>
        <p class="mt-6 font-semibold">Motivos comuns</p>
        <ul class="mt-2 space-y-1 text-text-2">
          <li>O link expirou (vale por 7 dias)</li>
          <li>O e-mail não é o mesmo da solicitação</li>
          <li>A solicitação já foi processada</li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/data-deletion" class="btn btn-primary">Tentar de novo</a>
          <a href="/" class="btn btn-ghost">Voltar ao site</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const API_URL = 'https://raptrak-production.up.railway.app';

  const params = new URLSearchParams(window.location.search);
  const token = params.get('token');
  const email = params.get('email');

  const loadingDiv = document.getElementById('verify-loading')!;
  const successDiv = document.getElementById('verify-success')!;
  const errorDiv = document.getElementById('verify-error')!;
  const errorMsg = document.getElementById('verify-error-msg')!;
  const graceDate = document.getElementById('grace-date')!;

  async function verify() {
    if (!token || !email) {
      loadingDiv.classList.add('hidden');
      errorMsg.textContent = 'O link está incompleto: faltam o token ou o e-mail.';
      errorDiv.classList.remove('hidden');
      return;
    }

    try {
      const res = await fetch(`${API_URL}/data-deletion/verify/${token}?email=${encodeURIComponent(email)}`);
      const data = await res.json();
      loadingDiv.classList.add('hidden');

      if (res.ok) {
        const date = new Date(data.scheduledDate);
        graceDate.textContent = date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
        successDiv.classList.remove('hidden');
      } else if (res.status === 400) {
        errorMsg.textContent = 'Essa solicitação já foi processada ou cancelada.';
        errorDiv.classList.remove('hidden');
      } else {
        errorMsg.textContent = data.message || 'Não deu pra verificar.';
        errorDiv.classList.remove('hidden');
      }
    } catch {
      loadingDiv.classList.add('hidden');
      errorMsg.textContent = 'Sem conexão com o servidor. Tente de novo.';
      errorDiv.classList.remove('hidden');
    }
  }

  verify();
</script>
