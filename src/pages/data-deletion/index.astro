---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Excluir meus dados · RapTrak" description="Solicite a exclusão dos seus dados pessoais do RapTrak.">
  <Header />

  <main id="conteudo" class="wrap pt-14 pb-24 lg:pt-20">
    <a href="/" class="inline-flex min-h-10 items-center text-sm text-text-2 hover:text-text">&larr; Voltar ao início</a>
    <div class="mt-6 grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h1 class="display-lg">Excluir meus dados</h1>
        <p class="lede mt-5">Peça a exclusão permanente da sua conta. Você recebe um e-mail pra confirmar; a conta é desativada na hora e apagada de vez depois de 30 dias. Detalhes na <a href="/privacy-policy" class="text-accent-ink underline underline-offset-4">política de privacidade</a>.</p>

        <div class="mt-10 rounded-[var(--radius-md)] border border-warning/40 bg-warning/10 p-5 text-text">
          <strong class="font-semibold">Atenção:</strong> depois de 30 dias, a exclusão não tem volta.
        </div>

        <dl class="mt-8 space-y-6">
          <div>
            <dt class="font-display text-xl font-extrabold uppercase">O que é apagado</dt>
            <dd class="mt-2 text-text-2">Nome, e-mail, senha e login com Google; foto, bio, redes sociais e cidade; seguidores, curtidas, presenças, notificações e imagens que você enviou.</dd>
          </div>
          <div>
            <dt class="font-display text-xl font-extrabold uppercase">O que fica, anonimizado</dt>
            <dd class="mt-2 text-text-2">Resultados, vitórias, troféus e comentários em batalhas, que fazem parte do histórico da cena e passam a aparecer como “Usuário deletado”.</dd>
          </div>
        </dl>
      </div>

      <div class="rounded-[var(--radius-lg)] border border-hairline bg-surface p-6 sm:p-8">
        <form id="deletion-form" class="space-y-6">
          <div>
            <label for="del-email" class="mb-2 block font-semibold">E-mail da sua conta</label>
            <input type="email" id="del-email" name="email" required autocomplete="email" placeholder="seu@email.com" class="w-full min-h-12 rounded-[var(--radius-md)] border border-[#2e2e2e] bg-bg px-4 py-3 text-text placeholder:text-muted focus:border-accent focus:outline-none" />
          </div>

          <div>
            <label for="del-reason" class="mb-2 block font-semibold">Motivo <span class="font-normal text-muted">(opcional)</span></label>
            <textarea id="del-reason" name="reason" rows="3" placeholder="Conta pra gente o que podia ser melhor" class="w-full min-h-12 rounded-[var(--radius-md)] border border-[#2e2e2e] bg-bg px-4 py-3 text-text placeholder:text-muted focus:border-accent focus:outline-none resize-none"></textarea>
          </div>

          <label class="flex cursor-pointer items-start gap-3">
            <input type="checkbox" id="del-confirm" required class="mt-1 size-5 shrink-0 accent-[#c21bda]" />
            <span class="text-text-2">Entendo que minha conta será apagada em definitivo depois de 30 dias e que isso não pode ser desfeito.</span>
          </label>

          <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row">
            <a href="/" class="btn btn-ghost flex-1">Cancelar</a>
            <button type="submit" id="del-submit" class="btn flex-1 bg-error text-white hover:bg-[#c93c40] disabled:cursor-not-allowed disabled:opacity-50">Pedir exclusão</button>
          </div>
        </form>

        <div id="del-loading" class="hidden py-10 text-center" role="status">
          <div class="mx-auto mb-4 size-8 animate-spin rounded-full border-2 border-accent border-t-transparent motion-reduce:animate-none"></div>
          <p class="text-text-2">Processando…</p>
        </div>

        <div id="del-success" class="hidden py-10 text-center" role="status">
          <h2 class="text-3xl">E-mail enviado</h2>
          <p class="mt-3 text-text-2">Confira sua caixa de entrada pra confirmar a exclusão. O link vale por 7 dias.</p>
        </div>

        <div id="del-error" class="mt-5 hidden rounded-[var(--radius-md)] border border-error/40 bg-error/10 p-4 text-center text-text" role="alert"></div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const API_URL = 'https://raptrak-production.up.railway.app';
  const form = document.getElementById('deletion-form') as HTMLFormElement;
  const submitBtn = document.getElementById('del-submit') as HTMLButtonElement;
  const loadingDiv = document.getElementById('del-loading')!;
  const successDiv = document.getElementById('del-success')!;
  const errorDiv = document.getElementById('del-error')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.classList.add('hidden');
    loadingDiv.classList.remove('hidden');
    errorDiv.classList.add('hidden');

    const email = (document.getElementById('del-email') as HTMLInputElement).value;
    const reason = (document.getElementById('del-reason') as HTMLTextAreaElement).value;

    try {
      const res = await fetch(`${API_URL}/data-deletion/request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, reason: reason || undefined }),
      });

      loadingDiv.classList.add('hidden');

      if (res.ok) {
        successDiv.classList.remove('hidden');
      } else {
        const data = await res.json();
        form.classList.remove('hidden');
        errorDiv.textContent = data.message || 'Não deu pra processar. Tente de novo.';
        errorDiv.classList.remove('hidden');
      }
    } catch {
      loadingDiv.classList.add('hidden');
      form.classList.remove('hidden');
      errorDiv.textContent = 'Sem conexão com o servidor. Tente de novo.';
      errorDiv.classList.remove('hidden');
    }
  });
</script>
