---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Phone from '../components/Phone.astro';

const PLAY = 'https://play.google.com/apps/testing/com.raptrak.app';
const APP = 'https://app.raptrak.me';

const publicos = [
  { quem: 'Fã', texto: 'Ache batalha perto de você, no mapa ou na lista. Siga as rodas que você curte e receba aviso quando tiver edição nova.' },
  { quem: 'MC', texto: 'Seu perfil com troféus, vitórias e posição no ranking. O histórico fica registrado, em vez de sumir no story de ontem.' },
  { quem: 'Organizador', texto: 'Página oficial da sua batalha, agenda, fotos e o resultado do dia publicado em poucos toques. Tudo de graça.' },
];

const passos = [
  { t: 'Crie sua conta', d: 'Entre com Google ou e-mail, escolha sua cidade e diga se você sobe no palco ou acompanha a cena.' },
  { t: 'Descubra batalhas', d: 'Na aba Descobrir, veja as batalhas no mapa ou em lista. Filtre por cidade, dia da semana e frequência.' },
  { t: 'Cadastre uma batalha', d: 'Não achou a sua? Cadastre em 4 passos: identidade e local, agenda, fotos e revisão. A equipe aprova rapidinho pra garantir que é real.' },
  { t: 'Assuma a página', d: 'Organiza uma batalha que já está no app? Peça a posse na página dela com um link ou uma foto que comprove. Aprovado, a página é sua.' },
  { t: 'Publique o resultado', d: 'Em cada edição: MCs, placar, troféus e resumo. Vale 1v1, 2v2, 3v3, sangue e conhecimento, e MC sem conta também entra.' },
  { t: 'Suba no ranking', d: 'Cada vitória conta pro ranking da cidade, do estado e da região onde a batalha rolou. Os troféus vão pro perfil do MC.' },
];

const faqs = [
  { q: 'O que é o RapTrak?', a: 'A rede social da cena de batalha de rima: pra achar batalha, acompanhar edições e resultados, montar perfil de MC, colecionar troféus e dar ferramenta pra quem organiza.' },
  { q: 'Precisa pagar alguma coisa?', a: 'Não. O RapTrak é grátis pra fã, MC e organizador. Todas as ferramentas de gestão de batalha também são gratuitas.' },
  { q: 'Como uso no celular?', a: 'No Android, entre no beta pela Google Play. Em qualquer celular, inclusive iPhone, dá pra usar tudo pelo navegador em app.raptrak.me.' },
  { q: 'E o app pra iPhone?', a: 'Está a caminho. Enquanto isso, a versão web funciona no Safari com as mesmas funções.' },
  { q: 'Tem campeonato com chaveamento?', a: 'Ainda não. É a próxima grande funcionalidade: eliminação simples, dupla e por pontos, com árvore pra acompanhar. Hoje você já registra edições, resultados e troféus.' },
  { q: 'Como cadastro minha batalha?', a: 'Crie sua conta, toque em Criar na aba Batalhas e siga os 4 passos. Depois da aprovação, a batalha aparece no mapa pra todo mundo.' },
  { q: 'Meus dados estão seguros?', a: 'Seguimos a LGPD. Você pode pedir a exclusão da conta a qualquer momento, pelo app (Configurações) ou pela página Excluir meus dados. A conta é removida em definitivo depois de 30 dias.' },
];

const trofeus = ['Campeão', 'Melhor flow', 'Melhor punchline', 'Favorito do público', 'Revelação', 'Veterano'];
---

<Layout title="RapTrak · A cena da batalha, num lugar só">
  <Header />

  <main id="conteudo">
    <!-- Hero -->
    <section class="overflow-hidden">
      <div class="wrap grid items-center gap-12 pt-14 pb-20 lg:grid-cols-[1.15fr_0.85fr] lg:pt-20 lg:pb-28">
        <div>
          <p class="rise mb-8 inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-2">
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-success" aria-hidden="true"></span>No ar na web</span>
            <span class="text-dim" aria-hidden="true">/</span><span>Beta no Android</span>
            <span class="text-dim" aria-hidden="true">/</span><span>iPhone em breve</span>
          </p>
          <h1 class="display-xl">
            <span class="reveal-line"><span>A cena da</span></span>
            <span class="reveal-line"><span>batalha, num</span></span>
            <span class="reveal-line"><span>lugar <span class="underline decoration-accent decoration-[0.09em] underline-offset-[0.12em]">só.</span></span></span>
          </h1>
          <p class="lede rise mt-8">Ache batalha de rima perto de você, acompanhe cada edição, monte seu perfil de MC e colecione troféus. Grátis pra toda a cena.</p>
          <div class="rise mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={APP} class="btn btn-primary">Abrir o app</a>
            <a href={PLAY} target="_blank" rel="noopener" class="btn btn-ghost">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.8 13.8 12 3.6 22.2a1 1 0 0 1-.6-.9V2.7a1 1 0 0 1 .6-.9Zm10.9 10.9 2.3 2.3-10.9 6.3 8.6-8.6Zm3.2-3.2 2.3 2.3a1 1 0 0 1 0 1.4l-2.3 2.3-2.3-2.3 2.3-2.3v-1.4ZM5.9 2.7 16.8 9l-2.3 2.3-8.6-8.6Z"/></svg>
              Android (beta)
            </a>
          </div>
        </div>

        <div class="rise-late relative mx-auto flex w-full max-w-md justify-center lg:max-w-none">
          <Phone src="/img/app-descobrir.jpeg" alt="Aba Batalhas do app, com batalhas de Curitiba e região: do Jaco, da Menô, da Matriz, do Triplex e da Colmeia" class="w-[54%] translate-y-10 -rotate-3" />
          <Phone src="/img/app-batalha.jpeg" alt="Página da Batalha do Jaco, em São José dos Pinhais, com foto da roda, próxima edição e botão para abrir no mapa" class="-ml-[12%] w-[58%] rotate-2" eager />
        </div>
      </div>
    </section>

    <!-- Públicos -->
    <section class="border-t border-hairline">
      <div class="wrap grid gap-10 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:py-28">
        <h2 class="display-lg">Pra quem vive a cena, não pra quem só assiste.</h2>
        <ul>
          {publicos.map((p) => (
            <li class="grid gap-2 border-b border-hairline py-7 first:pt-0 last:border-0 sm:grid-cols-[11rem_1fr] sm:gap-8">
              <h3 class="text-4xl">{p.quem}</h3>
              <p class="text-lg text-text-2">{p.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Destaques do produto -->
    <section class="bg-surface">
      <div class="wrap grid gap-16 py-20 lg:grid-cols-2 lg:gap-20 lg:py-28">
        <div>
          <h2 class="display-md">Resultado do dia em quatro passos</h2>
          <p class="mt-5 max-w-[34rem] text-lg text-text-2">Acabou a roda, o organizador publica tudo ali mesmo. O campeão ganha troféu automaticamente, e os troféus extras vão pro perfil de cada MC.</p>
          <div class="mt-8 rounded-[var(--radius-lg)] border border-hairline bg-bg p-6" role="img" aria-label="Exemplo da tela de resultado: etapas MCs, Placar, Troféus e Resumo, com a etapa Troféus aberta">
            <ol class="grid grid-cols-4 gap-2 text-center text-sm font-semibold">
              {['MCs', 'Placar', 'Troféus', 'Resumo'].map((s, i) => (
                <li class:list={['rounded-md border px-2 py-2', i === 2 ? 'border-accent bg-accent-soft text-text' : i < 2 ? 'border-hairline text-text-2' : 'border-hairline text-muted']}>
                  <span class="mono mr-1 text-xs">{i + 1}</span>{s}
                </li>
              ))}
            </ol>
            <p class="mono mt-6 text-xs uppercase tracking-wider text-muted">Modalidade</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {['1v1', '2v2', '3v3', 'Sangue', 'Conhecimento'].map((m, i) => <span class:list={['chip', i === 0 && 'chip-on']}>{m}</span>)}
            </div>
            <p class="mono mt-6 text-xs uppercase tracking-wider text-muted">Troféus da edição</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {trofeus.map((t, i) => <span class:list={['chip', i < 3 && 'chip-on']}>{t}</span>)}
            </div>
          </div>
        </div>

        <div>
          <h2 class="display-md">Ranking que respeita a quebrada</h2>
          <p class="mt-5 max-w-[34rem] text-lg text-text-2">Top MCs, Mais Ativos e Em Ascensão por cidade, estado, região ou no Brasil todo. A vitória conta onde a batalha aconteceu, não só onde o MC mora.</p>
          <div class="mt-8 rounded-[var(--radius-lg)] border border-hairline bg-bg p-6" role="img" aria-label="Exemplo dos filtros de ranking: Top MCs, Mais Ativos e Em Ascensão; Minha cidade, PR, Sul e Nacional">
            <div class="grid grid-cols-3 rounded-full border border-hairline bg-surface p-1 text-center text-sm font-semibold">
              <span class="rounded-full bg-accent-soft py-2 text-text">Top MCs</span>
              <span class="py-2 text-text-2">Mais Ativos</span>
              <span class="py-2 text-text-2">Em Ascensão</span>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="chip chip-on">Minha cidade</span><span class="chip">PR</span><span class="chip">Sul</span><span class="chip">Nacional</span>
            </div>
            <dl class="mt-6">
              {[['Cidade', '5.570 municípios do IBGE'], ['Estado', '27 UFs'], ['Região', 'Sul, Sudeste, Nordeste, Norte, Centro-Oeste'], ['Brasil', 'Ranking nacional']].map(([n, d]) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-hairline py-3 last:border-0">
                  <dt class="font-semibold">{n}</dt>
                  <dd class="mono text-right text-sm text-muted">{d}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Como funciona -->
    <section id="como-funciona" class="border-t border-hairline">
      <div class="wrap py-20 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
          <h2 class="display-lg">Como funciona</h2>
          <p class="lede lg:pt-3">Seis passos, da conta nova ao ranking. Dá pra fazer tudo pelo celular, no Android ou no navegador.</p>
        </div>
        <ol class="mt-14 grid gap-x-12 md:grid-cols-2">
          {passos.map((p, i) => (
            <li class="flex gap-6 border-t border-hairline py-8">
              <span class="w-8 shrink-0 font-display text-5xl font-extrabold leading-none text-dim" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="text-2xl">{p.t}</h3>
                <p class="mt-2 text-text-2">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Onde usar -->
    <section id="baixar" class="border-t border-hairline bg-surface">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:py-28">
        <h2 class="display-lg">Onde usar</h2>
        <div>
          <dl class="divide-y divide-hairline">
            <div class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center">
              <dt class="text-2xl font-display font-extrabold uppercase">Navegador</dt>
              <dd class="text-text-2">Funciona em qualquer celular ou computador, com todas as funções.</dd>
              <dd><a href={APP} class="btn btn-primary w-full sm:w-auto">app.raptrak.me</a></dd>
            </div>
            <div class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center">
              <dt class="text-2xl font-display font-extrabold uppercase">Android</dt>
              <dd class="text-text-2">App nativo em beta na Google Play. Pode ter bug; o feedback vai direto pra gente pelo app.</dd>
              <dd><a href={PLAY} target="_blank" rel="noopener" class="btn btn-ghost w-full sm:w-auto">Entrar no beta</a></dd>
            </div>
            <div class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center">
              <dt class="text-2xl font-display font-extrabold uppercase">iPhone</dt>
              <dd class="text-text-2">O app iOS está a caminho. Até lá, use pelo Safari.</dd>
              <dd><span class="chip">Em breve</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Chamada pra cena -->
    <section class="bg-accent text-white">
      <div class="wrap flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between lg:py-20">
        <div>
          <h2 class="display-lg max-w-3xl">Organiza batalha ou sobe no palco?</h2>
          <p class="mt-4 max-w-xl text-lg text-white">Veja tudo o que o RapTrak faz pela cena, e por que é grátis pra quem faz ela acontecer.</p>
        </div>
        <a href="/cena" class="btn btn-ink shrink-0">Ver a página da cena</a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <div class="wrap grid gap-10 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:py-28">
        <h2 class="display-lg">Perguntas frequentes</h2>
        <div class="divide-y divide-hairline border-y border-hairline">
          {faqs.map((f) => (
            <details class="group">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </summary>
              <p class="max-w-[62ch] pb-6 text-text-2">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
