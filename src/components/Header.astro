---
import Logo from './Logo.astro';

const navLinks = [
  { label: 'O app', href: '/' },
  { label: 'Pra cena', href: '/cena' },
  { label: 'Como funciona', href: '/#como-funciona' },
  { label: 'FAQ', href: '/#faq' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-hairline bg-bg/95 backdrop-blur-sm">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex min-h-11 items-center" aria-label="RapTrak, página inicial">
      <Logo size={24} />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav
          aria-current={path === link.href ? 'page' : undefined}
          class="rounded-md px-3 py-2 text-[0.95rem] font-medium text-text-2 transition-colors hover:text-text [&[aria-current]]:text-text [&[aria-current]]:underline [&[aria-current]]:decoration-accent [&[aria-current]]:decoration-2 [&[aria-current]]:underline-offset-8"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="https://app.raptrak.me" class="btn btn-primary hidden !min-h-10 !px-4 !py-2 text-[0.95rem] sm:inline-flex">Abrir o app</a>
      <button
        id="menu-btn"
        type="button"
        class="grid size-11 place-items-center rounded-md text-text-2 hover:bg-surface hover:text-text md:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu" class="hidden border-t border-hairline md:hidden" aria-label="Menu">
    <div class="wrap flex flex-col py-3">
      {navLinks.map((link) => (
        <a href={link.href} class="flex min-h-12 items-center border-b border-hairline font-display text-2xl font-extrabold uppercase text-text last:border-0">
          {link.label}
        </a>
      ))}
      <a href="https://app.raptrak.me" class="btn btn-primary mt-3">Abrir o app</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Na home, "Como funciona" e "FAQ" são âncoras da mesma página: o destaque segue a seção
  // em que a leitura está; fora delas, fica em "O app".
  if (location.pathname === '/') {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const home = links.find((a) => a.getAttribute('href') === '/');
    const sections = links
      .filter((a) => a.pathname === '/' && a.hash)
      .map((a) => ({ a, el: document.querySelector<HTMLElement>(a.hash) }))
      .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => !!s.el);
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const y = window.scrollY + window.innerHeight * 0.35;
      const hit = sections.find(({ el }) => el.offsetTop <= y && y < el.offsetTop + el.offsetHeight);
      const next = hit?.a ?? home;
      if (next === current) return;
      current = next;
      links.forEach((l) => l.removeAttribute('aria-current'));
      next?.setAttribute('aria-current', hit ? 'location' : 'page');
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
