---
import Logo from './Logo.astro';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'RapTrak',
    links: [
      { label: 'Abrir o app', href: 'https://app.raptrak.me' },
      { label: 'Android (beta)', href: 'https://play.google.com/apps/testing/com.raptrak.app' },
      { label: 'Pra cena', href: '/cena' },
      { label: 'Perguntas frequentes', href: '/#faq' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Política de privacidade', href: '/privacy-policy' },
      { label: 'Excluir meus dados', href: '/data-deletion' },
      { label: 'Segurança infantil', href: '/child-safety' },
      { label: 'lgpd@raptrak.me', href: 'mailto:lgpd@raptrak.me' },
    ],
  },
];
---

<footer class="border-t border-hairline bg-darkest">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo size={30} />
      <p class="mt-5 max-w-xs text-text-2">A cena da batalha, num lugar só.</p>
    </div>
    {cols.map((col) => (
      <div>
        <h2 class="font-display text-lg font-extrabold uppercase text-text">{col.title}</h2>
        <ul class="mt-4 space-y-1">
          {col.links.map((l) => (
            <li><a href={l.href} class="inline-flex min-h-10 items-center text-text-2 transition-colors hover:text-text">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap">
    <div class="flex flex-col gap-2 border-t border-hairline py-6 text-sm text-muted sm:flex-row sm:justify-between">
      <p>&copy; {year} RapTrak</p>
      <p>Feito com amor pela cena do rap brasileiro</p>
    </div>
  </div>
</footer>
